# Postgres (Neon). На Vercel змінна з'являється автоматично після підключення Neon у Storage.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob для фото. На Vercel з'являється автоматично після підключення Blob у Storage.
# Локально можна не задавати — фото зберігатимуться в public/uploads.
BLOB_READ_WRITE_TOKEN=

# Випадковий рядок мінімум 32 символи (підпис сесій адмінки).
SESSION_SECRET=

# Перший адміністратор — створюється автоматично, якщо в базі ще немає жодного.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
