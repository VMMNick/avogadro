# Postgres (Neon). На Vercel змінна з'являється автоматично після підключення Neon у Storage.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob для фото. На Vercel з'являється автоматично після підключення Blob у Storage.
# Локально можна не задавати — фото зберігатимуться в public/uploads.
BLOB_READ_WRITE_TOKEN=

# Випадковий рядок мінімум 32 символи (підпис сесій адмінки).
SESSION_SECRET=

# Перший адміністратор — створюється автоматично, якщо в базі ще немає жодного.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Код запрошення для самостійної реєстрації адміністраторів на /admin/register
# (мінімум 8 символів). Порожньо — реєстрацію вимкнено, нових адмінів додають у панелі.
ADMIN_INVITE_CODE=

# Адреса сайту (власний домен), напр. https://avogadro.com.ua. Необов'язково:
# без неї використовується основний домен проєкту на Vercel.
NEXT_PUBLIC_SITE_URL=

# Sentry — сповіщення про помилки на сайті (необов'язково, безкоштовний план Developer).
# DSN береться в Sentry: Project Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Необов'язково: щоб у звітах Sentry були зрозумілі рядки коду замість стиснутого.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
